# Hikvision NVR
NVR_URL=http://url.net
NVR_USR=admin
NVR_PASS=password
NVR_CHANNELS=8

# NVR timeouts and retries (lower timeout, more retries for flaky connections)
NVR_CONNECT_TIMEOUT=10
NVR_READ_TIMEOUT=15
NVR_STREAM_READ_TIMEOUT=120
NVR_RETRIES=10
NVR_RETRY_DELAY=3

# YOLO Model (ultralytics - yolov8n.pt or yolov5n.pt for CPU)
YOLO_MODEL=yolov8n.pt

# Telegram (optional - leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_COOLDOWN=120

# MQTT (optional - leave empty to disable)
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=hikvision/alerts
MQTT_USER=
MQTT_PASSWORD=

# Event sampling
EVENT_INITIAL_WAIT=3
EVENT_SAMPLE_INTERVAL=4
EVENT_MAX_DURATION=120

# Recognition thresholds
FACE_MATCH_THRESHOLD=0.6

# Web UI auth (leave empty for auto-generation on first run)
WEB_USER=
WEB_PASSWORD=
